# Environment variables for OJAAI
# Copy this file to .env and fill in your values

DATABASE_URL=postgresql://ojaai:password@localhost:5432/ojaai_dev
OPENFDA_API_KEY=
IMAGE_STORAGE_PATH=./data/prescriptions
CONFIDENCE_THRESHOLD=0.5
MAX_ACTIVE_MED_DAYS=90
LOG_LEVEL=INFO
API_KEY=secure-ojaai-rot-5678-auth
DEBUG_LOCAL_DASHBOARD=true

# Gemini LLM Configuration (get your key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
